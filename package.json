{
  "name": "box-yard",
  "version": "0.1.0",
  "private": true,
  "description": "One chat to run a yard of Claude Code agents inside Upstash Boxes.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "npm run build && npm run serve",
    "serve": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "deploy:box": "tsx scripts/deploy-box.ts",
    "deploy:vps": "bash scripts/deploy-vps.sh",
    "worker-snapshot": "tsx scripts/make-worker-snapshot.ts",
    "demo": "./yard demo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@upstash/box": "^0.7.10",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "happy-dom": "^21.0.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wouter": "^3.13.0"
  }
}
