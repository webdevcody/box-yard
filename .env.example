# ---- Box Yard settings. Copy to .env and fill in what you have. ----
# With nothing set, run `./yard demo` to try everything with a fake Claude.

# Claude Code login for the orchestrator and every agent.
# Run `claude setup-token` and paste the sk-ant-oat01-... token here.
CLAUDE_CODE_OAUTH_TOKEN=
# ...or an API key instead:
# ANTHROPIC_API_KEY=

# Upstash Box: worker boxes for agents (https://console.upstash.com). Starts with box_.
# Without it, agents run in folders on this machine (BOX_PROVIDER=local).
UPSTASH_BOX_API_KEY=
# Optional: a snapshot with Claude Code preinstalled (npm run worker-snapshot) for fast box starts.
# WORKER_SNAPSHOT_ID=

# Upstash Redis REST (optional): low-latency event bus between boxes and the orchestrator.
# Without it, the orchestrator reads each box's event log through the Box API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub token so agents can clone private repos, push branches, open PRs and issues.
# Easiest: `gh auth token` (classic OAuth token with repo + read:org scopes), which reaches
# every repo your account can, including org repos. Or a fine-grained token with
# Contents, Pull requests and Issues (read/write) on the repos you use.
GITHUB_TOKEN=
# Commit author for agent commits.
# GIT_USER_NAME=Box Yard Agent
# GIT_USER_EMAIL=box-yard@users.noreply.github.com

# Web UI password. Leave empty on localhost; set it anywhere public.
BOXYARD_PASSWORD=
# Public URL of this server (used in artifact links the orchestrator shares).
# BOXYARD_PUBLIC_URL=https://yard.example.com
# For `./yard deploy-vps`: serve HTTPS on this domain with Caddy.
# BOXYARD_DOMAIN=yard.example.com

# ---- Schedules ----
# Time zone for new schedules (default: this machine's zone).
# BOXYARD_TIMEZONE=America/New_York
# Optional: Upstash QStash also triggers schedules, so runs still happen when the
# orchestrator's box is paused. Needs BOXYARD_PUBLIC_URL too. Without these keys
# the server's own timer runs schedules and catches up on missed runs at startup.
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# ---- Pool tuning ----
# WORKER_SIZE=small         # small | medium | large (new boxes only)
# BOX_POOL_MAX=5            # boxes alive at once (Upstash free plan: 10 concurrent boxes)
# BOX_SLOTS=1               # agents running at once in one box (default by WORKER_SIZE: small 1, medium 2, large 4)
# BOX_MAX_AGENTS=0          # cap on agents running at once across all boxes (0 = no extra cap)
# BOXYARD_LOCAL_AGENTS=2    # agents of "Runs on: This computer" projects running at once on this machine (own queue, 1-32)
# BOXYARD_LOCAL_DIR=~/boxyard-workspaces   # where those agents work, a folder per task; keep it out of any folder with a CLAUDE.md
# BOX_MAX_RESIDENT=3        # task folders kept per box before parking old ones (small 3, medium 8, large 18)
# BOX_IDLE_DELETE_MINUTES=0 # delete boxes idle this long, once resident workspaces are archived (0 = keep)
# BOXYARD_WORKSPACE_RETENTION_DAYS=7 # park archived resting task folders from boxes after this many idle days
# BOXYARD_ARCHIVE_RETENTION_DAYS=7   # prune orphan and long-done archives after this many days
# BOXYARD_ARCHIVE_KEEP_TOUCHED_DAYS=30   # never prune archives of tasks touched this recently (open/unmerged PRs are always kept)
# The limits above are only defaults: values saved in Settings (UI) win and apply live.
# BOXYARD_MAX_UPLOAD_MB=20   # largest file you can attach to a message

# ---- Models (optional) ----
# Defaults are claude-opus-5-5 at high effort. These override the defaults; settings saved in the UI override these.
# ORCHESTRATOR_MODEL=
# WORKER_MODEL=
# Project Captains have their own model/effort (default claude-opus-5-5 at high). They wake on every project event,
# so a cheaper model here lowers cost.
# CAPTAIN_MODEL=
# CAPTAIN_EFFORT=high       # low | medium | high | xhigh | max

# ---- Project notes (optional) ----
# The notes budget: how many notes (and about how many tokens of them) go into each agent's prompt. Settings ›
# Max notes and a project's own value on its Settings tab override these.
# BOXYARD_NOTES_MAX=25
# BOXYARD_NOTES_MAX_TOKENS=4000

# ---- Voice: text-to-speech providers (optional) ----
# Settings › Voice can speak with ElevenLabs or OpenAI instead of the browser's voices. Keys saved in the UI win
# over these; either way they stay on the server and the browser only sees "set" or "unset".
# TTS_PROVIDER=browser      # browser | elevenlabs | openai
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=

# PORT=3000
# BOXYARD_DATA_DIR=./data
