# ---- Box Yard settings. Copy to .env and fill in what you have. ----
# With nothing set, run `./yard demo` to try everything with a fake Claude.

# Claude Code login for the orchestrator and every agent.
# Run `claude setup-token` and paste the sk-ant-oat01-... token here.
CLAUDE_CODE_OAUTH_TOKEN=
# ...or an API key instead:
# ANTHROPIC_API_KEY=

# Upstash Box: worker boxes for agents (https://console.upstash.com). Starts with box_.
# Without it, agents run in folders on this machine (BOX_PROVIDER=local).
UPSTASH_BOX_API_KEY=
# Optional: a snapshot with Claude Code preinstalled (npm run worker-snapshot) for fast box starts.
# WORKER_SNAPSHOT_ID=

# Upstash Redis REST (optional): low-latency event bus between boxes and the orchestrator.
# Without it, the orchestrator reads each box's event log through the Box API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub token so agents can clone private repos, push branches, open PRs and issues.
# Easiest: `gh auth token` (classic OAuth token with repo + read:org scopes), which reaches
# every repo your account can, including org repos. Or a fine-grained token with
# Contents, Pull requests and Issues (read/write) on the repos you use.
GITHUB_TOKEN=
# Commit author for agent commits.
# GIT_USER_NAME=Box Yard Agent
# GIT_USER_EMAIL=box-yard@users.noreply.github.com

# Web UI password. Leave empty on localhost; set it anywhere public.
BOXYARD_PASSWORD=
# Public URL of this server (used in artifact links the orchestrator shares).
# BOXYARD_PUBLIC_URL=https://yard.example.com
# For `./yard deploy-vps`: serve HTTPS on this domain with Caddy.
# BOXYARD_DOMAIN=yard.example.com

# ---- Schedules ----
# Time zone for new schedules (default: this machine's zone).
# BOXYARD_TIMEZONE=America/New_York
# Optional: Upstash QStash also triggers schedules, so runs still happen when the
# orchestrator's box is paused. Needs BOXYARD_PUBLIC_URL too. Without these keys
# the server's own timer runs schedules and catches up on missed runs at startup.
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# ---- Pool tuning ----
# BOX_POOL_MAX=5            # boxes alive at once (free plan: about 5)
# BOX_SLOTS=2               # agents running at once in one box
# BOXYARD_MAX_UPLOAD_MB=20   # largest file you can attach to a message
# BOX_MAX_RESIDENT=12       # task folders kept per box before parking old ones
# BOX_IDLE_DELETE_MINUTES=0 # delete boxes idle this long (workspaces are archived first)
# WORKER_SIZE=small         # small | medium | large

# ---- Models (optional) ----
# Defaults are claude-opus-5-5 at high effort. These override the defaults; settings saved in the UI override these.
# ORCHESTRATOR_MODEL=
# WORKER_MODEL=

# PORT=3000
# BOXYARD_DATA_DIR=./data
